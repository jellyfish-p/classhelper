<Window x:Class="ClassHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="课堂助手"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F9F8F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Margin="24,24,16,28">
                        <TextBlock Text="课堂助手" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="安静常驻 · 两秒可用" Margin="0,5,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                    </StackPanel>
                    <Button Style="{StaticResource NavButton}" Content="总览" Tag="0" Click="Navigate_Click" />
                    <Button Style="{StaticResource NavButton}" Content="随机点名" Tag="1" Click="Navigate_Click" />
                    <Button Style="{StaticResource NavButton}" Content="固定名单" Tag="2" Click="Navigate_Click" />
                    <Button Style="{StaticResource NavButton}" Content="显示与启动" Tag="3" Click="Navigate_Click" />
                    <Button Style="{StaticResource NavButton}" Content="关于第一版" Tag="4" Click="Navigate_Click" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="12" Padding="12" Background="#EEF0F8" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="第一版范围" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="课表与教学日历将在后续版本开放" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>

            <TabControl x:Name="MainTabs"
                        Grid.Row="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,28">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="总览" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DateLabel}" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                                <Button HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="开始点名"
                                        Click="StartBalanced_Click" />
                            </Grid>

                            <Border Style="{StaticResource CardBorder}" Margin="0,28,0,0" Background="#F8F9FD">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="桌面课程栏" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="课表尚未配置" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBlock Text="第一版先完成课堂点名与桌面启动体验，排课功能稍后接入。"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,8,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#ECEFF8" CornerRadius="20" Padding="14,8" VerticalAlignment="Center">
                                        <TextBlock Text="预留" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="固定名单" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding RosterSummary}" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0" />
                                        <TextBlock Text="名单只保存在这台电脑中" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,18" />
                                        <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="管理名单" Tag="2" Click="Navigate_Click" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="默认点名方式" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="均衡轮选" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,0" />
                                        <TextBlock Text="一轮内不重复，全部点过后自动开始新一轮" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,18" />
                                        <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Content="查看两种方式" Tag="1" Click="Navigate_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,28" MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="随机点名" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="选择本次点名方式；打开后可以连续抽取。" Margin="0,6,0,26" Foreground="{StaticResource TextSecondaryBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="独立随机" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="每一次都从完整名单中独立抽取，因此可能连续抽到同一个人。" Margin="0,10,0,22" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22" />
                                        <Button Style="{StaticResource SecondaryButton}" Content="使用独立随机" Click="StartIndependent_Click" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardBorder}" BorderBrush="{StaticResource BrandBrush}" BorderThickness="2">
                                    <StackPanel>
                                        <TextBlock Text="均衡轮选" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="一轮内不会重复；全部点过后，自动开始下一轮。" Margin="0,10,0,22" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="使用均衡轮选" Click="StartBalanced_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0" Background="#FFF8EC">
                                <TextBlock Text="提示：抽取结果在动画开始前已经确定，关闭动画不会改变结果。" Foreground="#76501C" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="32,28">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="固定名单" FontSize="26" FontWeight="SemiBold" />
                                <TextBlock Text="姓名必填，学号或座号可选。" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButton}" Content="新增成员" Margin="0,0,10,0" Click="AddMember_Click" />
                                <Button Style="{StaticResource PrimaryButton}" Content="保存名单" Click="SaveRoster_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,22,0,16" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RosterPasteBox"
                                         MinHeight="56"
                                         Padding="10"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         ToolTip="每行一人，可写为：姓名, 学号" />
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="预览粘贴内容"
                                        Click="PreviewRoster_Click" />
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Roster}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  BorderBrush="{StaticResource BorderBrush}"
                                  Background="{StaticResource SurfaceRaisedBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="姓名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTextColumn Header="学号 / 座号" Binding="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridCheckBoxColumn Header="参与点名" Binding="{Binding IsActive}" Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,28" MaxWidth="820" HorizontalAlignment="Left">
                            <TextBlock Text="显示与启动" FontSize="26" FontWeight="SemiBold" />
                            <TextBlock Text="第一版提供桌面占位栏和贴边启动器。" Margin="0,6,0,24" Foreground="{StaticResource TextSecondaryBrush}" />

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="桌面组件" FontSize="18" FontWeight="SemiBold" />
                                    <CheckBox x:Name="BannerVisibilityCheckBox"
                                              Content="显示顶部课程栏占位"
                                              IsChecked="True"
                                              Margin="0,18,0,0"
                                              Checked="BannerVisibility_Changed"
                                              Unchecked="BannerVisibility_Changed" />
                                    <TextBlock Text="课程栏始终位于普通窗口下方，当前只显示日期和后续功能提示。" TextWrapping="Wrap" Margin="24,7,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Windows 启动" FontSize="18" FontWeight="SemiBold" />
                                    <CheckBox x:Name="AutoStartCheckBox"
                                              Content="登录 Windows 后自动启动课堂助手"
                                              Margin="0,18,0,0"
                                              Checked="AutoStart_Changed"
                                              Unchecked="AutoStart_Changed" />
                                    <TextBlock Text="这是当前 Windows 用户的设置，可以随时关闭。" Margin="24,7,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <StackPanel Margin="32,28" MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="关于第一版" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="ClassHelper 0.1 Preview" FontSize="18" FontWeight="SemiBold" Margin="0,28,0,0" />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="23">
                            这一版用于验证课堂电脑上的常驻体验与随机点名闭环。固定名单和设置只保存在本机，不包含账户、云同步或遥测。
                        </TextBlock>
                        <Border Style="{StaticResource CardBorder}" Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock Text="本地数据文件" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding DataFilePath}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Border Grid.Row="1" Background="#F9F8F4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="18,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
        </Grid>
    </Grid>
</Window>
