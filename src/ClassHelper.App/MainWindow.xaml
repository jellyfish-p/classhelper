<Window x:Class="ClassHelper.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="课堂助手"
        Width="1140"
        Height="740"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource NavigationBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="20,22,18,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" Background="{StaticResource BrandBrush}" CornerRadius="10">
                            <TextBlock Text="课"
                                       Foreground="White"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="课堂助手" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="名单与点名" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="工作区"
                               Margin="24,0,0,7"
                               FontSize="11"
                               Foreground="{StaticResource TextTertiaryBrush}" />

                    <RadioButton x:Name="OverviewNav"
                                 GroupName="Navigation"
                                 IsChecked="True"
                                 Style="{StaticResource NavRadioButton}"
                                 Tag="0"
                                 Click="Navigate_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="总览" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="RollCallNav"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavRadioButton}"
                                 Tag="1"
                                 Click="Navigate_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="随机点名" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="RosterNav"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavRadioButton}"
                                 Tag="2"
                                 Click="Navigate_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="固定名单" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="SettingsNav"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavRadioButton}"
                                 Tag="3"
                                 Click="Navigate_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="启动设置" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>

                    <RadioButton x:Name="AboutNav"
                                 GroupName="Navigation"
                                 Style="{StaticResource NavRadioButton}"
                                 Tag="4"
                                 Click="Navigate_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="关于" VerticalAlignment="Center" />
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Margin="14"
                        Padding="13"
                        Background="#F5F7FA"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="15"
                                   Foreground="{StaticResource BrandBrush}"
                                   VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="本机数据" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="不上传名单与点名结果"
                                       Margin="0,3,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <TabControl x:Name="MainTabs"
                        Grid.Row="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,32,38,38">
                            <TextBlock Text="总览" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="{Binding DateLabel}" Margin="0,3,0,0" Style="{StaticResource BodyText}" />

                            <Border Margin="0,28,0,0"
                                    Padding="28"
                                    Background="{StaticResource BrandSoftBrush}"
                                    BorderBrush="#C7D4FA"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="准备好了吗？" FontSize="13" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="开始一次均衡轮选" Margin="0,8,0,0" FontSize="25" FontWeight="SemiBold" />
                                        <TextBlock Text="一轮内不重复，点完所有成员后自动进入下一轮。"
                                                   Margin="0,8,0,20"
                                                   Style="{StaticResource BodyText}" />
                                        <Button HorizontalAlignment="Left"
                                                Style="{StaticResource PrimaryButton}"
                                                MinWidth="132"
                                                Content="开始点名"
                                                Click="StartBalanced_Click" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="当前名单" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Roster.Count}" FontFamily="Segoe UI Variable Display" FontSize="56" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="名单成员" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.35*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="当前配置" Style="{StaticResource SectionTitle}" />
                                        <Grid Margin="0,20,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="固定名单" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding RosterSummary}" Style="{StaticResource BodyText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="管理" Tag="2" Click="Navigate_Click" />
                                        </Grid>
                                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="点名方式" FontWeight="SemiBold" />
                                                <TextBlock Text="默认使用均衡轮选" Style="{StaticResource BodyText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource QuietButton}" Content="更改" Tag="1" Click="Navigate_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Background="{StaticResource SurfaceSubtleBrush}">
                                    <StackPanel>
                                        <TextBlock Text="课堂中怎么用" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="1" Margin="0,18,0,0" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" />
                                        <TextBlock Text="拖动启动器到顺手的位置" Margin="0,2,0,0" FontWeight="SemiBold" />
                                        <TextBlock Text="2" Margin="0,14,0,0" FontFamily="Segoe UI Variable Display" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource BrandBrush}" />
                                        <TextBlock Text="点击点名，直接抽取" Margin="0,2,0,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,32,38,38" MaxWidth="840" HorizontalAlignment="Left">
                            <TextBlock Text="随机点名" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="选择适合本次课堂的抽取方式。" Margin="0,3,0,28" Style="{StaticResource BodyText}" />

                            <Border Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#F0F2F6">
                                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,24,0">
                                        <TextBlock Text="独立随机" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="每次从完整名单抽取，可能连续抽到同一位成员。" Margin="0,5,0,0" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="使用此方式" VerticalAlignment="Center" Click="StartIndependent_Click" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorder}"
                                    Margin="0,14,0,0"
                                    Background="{StaticResource BrandSoftBrush}"
                                    BorderBrush="#B9C9F7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource BrandBrush}">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,24,0">
                                        <TextBlock Text="均衡轮选" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="一轮内不重复，所有成员点过后自动开始下一轮。" Margin="0,5,0,0" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="使用此方式" VerticalAlignment="Center" Click="StartBalanced_Click" />
                                </Grid>
                            </Border>

                            <Border Margin="0,22,0,0" Padding="16" Background="#F7F8FA" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="15" Foreground="{StaticResource BrandBrush}" />
                                    <TextBlock Grid.Column="1" Text="抽取结果会在动画开始前确定，动画不会影响公平性。" Style="{StaticResource BodyText}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="38,32,38,34">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="固定名单" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="姓名必填，学号或座号可选。" Margin="0,3,0,0" Style="{StaticResource BodyText}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Content="新增成员" Margin="0,0,10,0" Click="AddMember_Click" />
                                <Button Style="{StaticResource PrimaryButton}" Content="保存名单" Click="SaveRoster_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,24,0,16"
                                Padding="16"
                                Background="{StaticResource SurfaceSubtleBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="从表格粘贴" FontSize="12" FontWeight="SemiBold" Margin="1,0,0,7" />
                                    <TextBox x:Name="RosterPasteBox"
                                             Style="{StaticResource InputTextBox}"
                                             MinHeight="44"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             ToolTip="每行一人，可写为：姓名, 学号"
                                             automation:AutomationProperties.Name="粘贴名单文本" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Margin="12,23,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="预览内容"
                                        VerticalAlignment="Top"
                                        Click="PreviewRoster_Click" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid>
                                <DataGrid x:Name="RosterGrid"
                                          ItemsSource="{Binding Roster}"
                                          Style="{StaticResource RosterDataGrid}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="姓名" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                        <DataGridTextColumn Header="学号 / 座号" Binding="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridCheckBoxColumn Header="参与点名" Binding="{Binding IsActive}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=RosterGrid}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="26" Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="名单还是空的" Margin="0,12,0,0" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="新增成员，或在上方粘贴名单。" Margin="0,5,0,0" Style="{StaticResource BodyText}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,32,38,38" MaxWidth="820" HorizontalAlignment="Left">
                            <TextBlock Text="启动设置" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="管理快捷启动器和 Windows 登录启动行为。" Margin="0,3,0,28" Style="{StaticResource BodyText}" />

                            <Border Style="{StaticResource CardBorder}" Padding="0">
                                <StackPanel>
                                    <Grid Margin="22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrandSoftBrush}">
                                            <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="快捷启动器" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="拖动顶部把手移动，松开后自动吸附最近边缘。" Margin="0,4,0,0" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource BorderBrush}" />
                                    <Grid Margin="22">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrandSoftBrush}">
                                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,24,0">
                                            <TextBlock Text="登录时自动启动" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="只影响当前 Windows 用户，可以随时关闭。" Margin="0,4,0,0" Style="{StaticResource BodyText}" />
                                        </StackPanel>
                                        <CheckBox x:Name="AutoStartCheckBox"
                                                  Grid.Column="2"
                                                  Style="{StaticResource SwitchCheckBox}"
                                                  VerticalAlignment="Center"
                                                  Checked="AutoStart_Changed"
                                                  Unchecked="AutoStart_Changed"
                                                  automation:AutomationProperties.Name="登录时自动启动" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="38,32,38,38" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="关于" Style="{StaticResource PageTitle}" />
                            <Border Margin="0,28,0,0" Style="{StaticResource CardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" Background="{StaticResource BrandBrush}" CornerRadius="14" VerticalAlignment="Top">
                                        <TextBlock Text="课" Foreground="White" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="ClassHelper" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock Text="0.1 Preview" Margin="0,3,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="面向教室固定电脑的本地名单与随机点名工具。"
                                                   Margin="0,16,0,0"
                                                   Style="{StaticResource BodyText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="数据与隐私" Margin="0,30,0,12" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="名单和设置只保存在本机，不包含账户、云同步或遥测。" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18" />
                                    <TextBlock Text="数据文件" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DataFilePath}" Margin="0,6,0,0" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="1"
                    Background="#EEF1F5"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="13" Foreground="{StaticResource BrandBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
