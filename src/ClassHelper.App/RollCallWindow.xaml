<Window x:Class="ClassHelper.App.RollCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="随机点名"
        Width="900"
        Height="540"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconSurface" Property="Background" Value="#E7EBF2" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconSurface" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalModeButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Width" Value="126" />
            <Setter Property="Height" Value="52" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="13,8" />
        </Style>

        <Style x:Key="VerticalModeActiveButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="126" />
            <Setter Property="Height" Value="52" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="13,8" />
        </Style>

        <Style x:Key="DrawSurfaceButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DrawSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="0,16,16,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DrawSurface" Property="Background" Value="#24E7EDFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DrawSurface" Property="Background" Value="#3DE0E8FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DrawSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="#D5DCE7"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect Color="#263A59" BlurRadius="28" ShadowDepth="6" Opacity="0.22" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="166" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F4F6FA"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="17,0,0,17">
                <Grid Margin="19,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,12,0,0">
                        <TextBlock Text="抽取模式"
                                   Margin="4,0,0,9"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" />

                        <Button x:Name="IndependentModeButton"
                                Style="{StaticResource VerticalModeButton}"
                                Click="Independent_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="27" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8AB;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="独立随机" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="BalancedModeButton"
                                Style="{StaticResource VerticalModeActiveButton}"
                                Margin="0,9,0,0"
                                Click="Balanced_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="27" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="15" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="均衡轮选" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="4,0,0,3">
                        <TextBlock x:Name="ModeText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrandBrush}" />
                        <TextBlock x:Name="RemainingText"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border Background="Transparent" MouseLeftButtonDown="WindowDrag_MouseLeftButtonDown" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0">
                        <Button Style="{StaticResource IconButton}"
                                Margin="0,0,3,0"
                                ToolTip="重置本轮"
                                Click="Reset_Click"
                                automation:AutomationProperties.Name="重置本轮">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="17" />
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                                ToolTip="退出点名"
                                Click="Close_Click"
                                automation:AutomationProperties.Name="退出点名">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Button x:Name="DrawButton"
                        Grid.Row="1"
                        Style="{StaticResource DrawSurfaceButton}"
                        Click="Draw_Click"
                        automation:AutomationProperties.Name="点击中央区域抽取成员">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0" />
                                <GradientStop Color="#EFF3FF" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="38,0,38,48">
                            <TextBlock x:Name="HintText"
                                       Text="点击中央区域开始"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14" />
                            <TextBlock x:Name="ResultNameText"
                                       Text="点击抽取"
                                       HorizontalAlignment="Center"
                                       Margin="0,15,0,0"
                                       FontFamily="Microsoft YaHei UI"
                                       FontSize="72"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       automation:AutomationProperties.LiveSetting="Assertive"
                                       automation:AutomationProperties.Name="点名结果" />
                            <TextBlock x:Name="ResultNumberText"
                                       HorizontalAlignment="Center"
                                       Margin="0,9,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="17" />
                        </StackPanel>

                        <TextBlock Text="点击任意空白区域抽取下一位"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,25"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
