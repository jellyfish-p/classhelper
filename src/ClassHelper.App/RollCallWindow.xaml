<Window x:Class="ClassHelper.App.RollCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="随机点名"
        Width="960"
        Height="560"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#F3F1EC"
        Topmost="True">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ModeText" FontSize="16" FontWeight="SemiBold" />
                <Border Background="#E9ECF8" CornerRadius="12" Padding="10,5" Margin="12,0,0,0">
                    <TextBlock x:Name="RemainingText" Foreground="#425FC7" FontSize="12" />
                </Border>
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Content="结束点名" Click="Close_Click" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,26"
                Background="#FBFAF7"
                BorderBrush="#DCE1E6"
                BorderThickness="1"
                CornerRadius="18">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="HintText"
                               Text="准备好后开始抽取"
                               HorizontalAlignment="Center"
                               Foreground="#66717F"
                               FontSize="15" />
                    <TextBlock x:Name="ResultNameText"
                               Text="—"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"
                               FontSize="68"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ResultNumberText"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Foreground="#66717F"
                               FontSize="18" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="独立随机" Margin="0,0,10,0" Click="Independent_Click" />
                <Button Style="{StaticResource SecondaryButton}" Content="均衡轮选" Click="Balanced_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="重置本轮" Margin="0,0,10,0" Click="Reset_Click" />
                <Button x:Name="DrawButton" Style="{StaticResource PrimaryButton}" Content="抽一位" MinWidth="128" Click="Draw_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
