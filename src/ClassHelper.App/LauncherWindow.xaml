<Window x:Class="ClassHelper.App.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Width="68"
        Height="244"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Window.Resources>
        <Style x:Key="LauncherButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="#F1F3F7" />
            <Setter Property="Foreground" Value="#4F5B6B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E4E9F2" />
                                <Setter Property="Foreground" Value="#2F5BD3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherPrimaryButton" TargetType="Button" BasedOn="{StaticResource LauncherButton}">
            <Setter Property="Background" Value="#2F5BD3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="12" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#244CB8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Padding="5"
            Background="#F9FFFFFF"
            BorderBrush="#D1D8E2"
            BorderThickness="1"
            CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect Color="#334B71" BlurRadius="20" ShadowDepth="4" Opacity="0.2" />
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="打开主控面板" Click="OpenMain_Click" />
                <Separator />
                <MenuItem Header="退出课堂助手" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel>
            <Border Height="22"
                    Background="Transparent"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                    automation:AutomationProperties.Name="拖动启动器">
                <Border Width="20" Height="3" Background="#A9B2C0" CornerRadius="2" VerticalAlignment="Center" />
            </Border>

            <Button Style="{StaticResource LauncherPrimaryButton}"
                    Margin="0,3,0,0"
                    ToolTip="随机点名"
                    Click="RollCall_Click"
                    automation:AutomationProperties.Name="随机点名">
                <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="20" />
            </Button>

            <Button Style="{StaticResource LauncherButton}"
                    Margin="0,5,0,0"
                    ToolTip="固定名单"
                    Click="Roster_Click"
                    automation:AutomationProperties.Name="固定名单">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="19" />
            </Button>

            <Button Style="{StaticResource LauncherButton}"
                    Margin="0,5,0,0"
                    ToolTip="主控面板"
                    Click="OpenMain_Click"
                    automation:AutomationProperties.Name="主控面板">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="19" />
            </Button>
        </StackPanel>
    </Border>
</Window>
