<Window x:Class="ClassHelper.App.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="64"
        Height="278"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Border Background="#F7FFFFFF"
            BorderBrush="#D5DAE2"
            BorderThickness="1"
            CornerRadius="20"
            Padding="7">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="打开主控面板" Click="OpenMain_Click" />
                <Separator />
                <MenuItem Header="退出课堂助手" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
            <Border Height="24" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center">
                    <Rectangle Width="20" Height="2" RadiusX="1" RadiusY="1" Fill="#A8B0BC" Margin="0,0,0,3" />
                    <Rectangle Width="20" Height="2" RadiusX="1" RadiusY="1" Fill="#A8B0BC" />
                </StackPanel>
            </Border>

            <Button Height="50" Margin="0,7,0,0" ToolTip="随机点名" Click="RollCall_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="#425FC7" CornerRadius="14">
                            <TextBlock Text="点名" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#354FAE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Height="50" Margin="0,7,0,0" ToolTip="固定名单" Click="Roster_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="#EEF0F5" CornerRadius="14">
                            <TextBlock Text="名单" Foreground="#18212B" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E1E5ED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Height="50" Margin="0,7,0,0" ToolTip="主控面板" Click="OpenMain_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="#EEF0F5" CornerRadius="14">
                            <TextBlock Text="主控" Foreground="#18212B" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E1E5ED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
