<Window x:Class="ClassHelper.App.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Width="56"
        Height="168"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="LauncherButton" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="TopPrimary">
                                <Setter TargetName="ButtonSurface" Property="CornerRadius" Value="14,14,0,0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Middle">
                                <Setter TargetName="ButtonSurface" Property="CornerRadius" Value="0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Bottom">
                                <Setter TargetName="ButtonSurface" Property="CornerRadius" Value="0,0,14,14" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource BrandSoftBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource BrandBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="TopPrimary" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource BrandHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.84" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#89A4F4" />
                                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherPrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource LauncherButton}">
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="打开主控面板" Click="OpenMain_Click" />
                <Separator />
                <MenuItem Header="退出课堂助手" Click="Exit_Click" />
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
            <RowDefinition Height="18" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <Border Background="Transparent"
                Cursor="SizeAll"
                MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                automation:AutomationProperties.Name="拖动启动器">
            <Border Width="22"
                    Height="3"
                    Background="{StaticResource TextTertiaryBrush}"
                    CornerRadius="2"
                    Opacity="0.75"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Row="1">
            <Button Style="{StaticResource LauncherPrimaryButton}"
                    Tag="TopPrimary"
                    ToolTip="随机点名"
                    Click="RollCall_Click"
                    automation:AutomationProperties.Name="随机点名">
                <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="20" />
            </Button>

            <Button Style="{StaticResource LauncherButton}"
                    Tag="Middle"
                    ToolTip="固定名单"
                    Click="Roster_Click"
                    automation:AutomationProperties.Name="固定名单">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="19" />
            </Button>

            <Button Style="{StaticResource LauncherButton}"
                    Tag="Bottom"
                    ToolTip="主控面板"
                    Click="OpenMain_Click"
                    automation:AutomationProperties.Name="主控面板">
                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="19" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
