<Window x:Class="ClassHelper.App.BannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="920"
        Height="76"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False">
    <Border Background="#F2FBFAF7"
            BorderBrush="#DCE1E6"
            BorderThickness="1"
            CornerRadius="14"
            Padding="20,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="DateText" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="第一版 · 课堂常驻栏" Margin="0,3,0,0" FontSize="11" Foreground="#66717F" />
            </StackPanel>

            <Border Grid.Column="1" Background="#DCE1E6" Margin="0,4" />

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="22,0">
                <TextBlock Text="课表尚未配置" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="当前版本先开放固定名单与随机点名" Margin="0,3,0,0" FontSize="12" Foreground="#66717F" />
            </StackPanel>

            <Border Grid.Column="3" Background="#DCE1E6" Margin="0,4" />

            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="TimeText" FontFamily="Segoe UI Variable" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="本机时间" FontSize="11" Foreground="#66717F" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
